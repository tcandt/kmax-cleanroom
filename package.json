{
  "name": "kmax-cleanroom",
  "version": "1.0.0",
  "description": "KMAX Clean-Room Unified Development Environment",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node scripts/start-backend.js",
    "dev:frontend": "npm --prefix reconstructed_source/web-app run dev",
    "build:backend": "node scripts/build-backend.js",
    "build:frontend": "npm --prefix reconstructed_source/web-app run build",
    "build": "npm run build:backend && npm run build:frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
